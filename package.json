{
  "name": "digikladde-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^26.12.1",
    "npm": "11.20.0"
  },
  "workspaces": [
    "app",
    "relay"
  ],
  "scripts": {
    "test": "npm run test:app && npm run test:relay",
    "test:app": "npm run -w app test --",
    "test:relay": "npm run -w relay test --",
    "test:e2e": "npm run -w app test:e2e --",
    "typecheck:tests": "npm run -w app typecheck:tests",
    "dev:app": "npm run -w app dev",
    "lint": "npm run lint:app && npm run lint:relay",
    "lint:app": "npm run -w app lint",
    "lint:relay": "npm run -w relay lint",
    "build": "npm run build:app && npm run build:relay",
    "build:app": "npm run -w app build",
    "build:relay": "npm run -w relay build",
    "preview": "node scripts/preview.mjs",
    "typecheck:relay": "npm run -w relay typecheck",
    "capture:guide-media": "node app/scripts/run-capture-with-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "workbox-build@7.4.1": {
      "glob": "13.0.6"
    }
  },
  "allowScripts": {
    "core-js": true,
    "esbuild": true,
    "fsevents": true
  }
}
